APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Control-plane database (vendors, users, audit). Hosted Postgres in production:
# postgresql+psycopg://user:pass@host:5432/vendorlens_control
DATABASE_URL=
# Per-vendor database template; {tenant} is replaced per vendor (required in production):
# postgresql+psycopg://user:pass@host:5432/sales_{tenant}
TENANT_DATABASE_URL_TEMPLATE=
# Set to true when serving over HTTPS
SECURE_COOKIES=false
